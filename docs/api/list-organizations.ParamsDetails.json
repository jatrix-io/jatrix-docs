{
  "parameters": [
    {
      "name": "limit",
      "in": "query",
      "schema": { "type": "integer", "default": 20, "maximum": 100 },
      "description": "Pagination limit"
    },
    {
      "name": "offset",
      "in": "query",
      "schema": { "type": "integer", "default": 0 },
      "description": "Pagination offset"
    },
    {
      "name": "X-Request-ID",
      "in": "header",
      "required": false,
      "schema": { "type": "string", "format": "uuid" },
      "description": "Client-supplied request ID for correlation. Echoed in response meta."
    }
  ]
}
